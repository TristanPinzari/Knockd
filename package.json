{
  "name": "knockd",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --filter \"!knockd\" --if-present typecheck",
    "lint": "pnpm -r --filter \"!knockd\" --if-present lint",
    "test": "pnpm -r --filter \"!knockd\" --if-present test",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "typescript": "~5.8",
    "typescript-eslint": "^8.73.0"
  }
}
