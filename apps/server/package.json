{
  "name": "@knockd/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "drizzle-kit migrate && tsx src/db/continuous-aggregates.ts",
    "db:studio": "drizzle-kit studio",
    "smoke": "tsx scripts/smoke-sessions.ts",
    "smoke:accounts": "tsx scripts/smoke-accounts.ts",
    "smoke:sim": "tsx scripts/smoke-sim.ts",
    "smoke:processing": "tsx scripts/smoke-processing.ts",
    "data:download": "tsx scripts/london/download.ts",
    "data:import": "tsx scripts/london/import.ts",
    "data:census": "tsx scripts/london/census.ts"
  },
  "dependencies": {
    "@knockd/shared": "workspace:*",
    "@protomaps/basemaps": "^5.7.2",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5",
    "express-oauth2-jwt-bearer": "^1.11.0",
    "jose": "^6.2.18",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pmtiles": "^4.5.0",
    "postgres": "^4.1.1",
    "socket.io": "^4",
    "zod": "^3.25"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "22",
    "@types/shapefile": "^0.6.4",
    "@types/yauzl": "^3.4.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "shapefile": "^0.6.6",
    "socket.io-client": "^4",
    "tsx": "^4.23.15",
    "yauzl": "^3.4.0"
  }
}
